{
  "expo": {
    "name": "MedVerify AI",
    "slug": "medverify-ai",
    "scheme": "medverifyai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.jpg",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.jpg",
        "backgroundColor": "#0A0F1D"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-router",
      "expo-splash-screen",
      "expo-sqlite",
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}