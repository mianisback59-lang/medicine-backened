    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.jpg",
        "backgroundColor": "#0A0F1D"
      },
      "package": "com.medverify_user.medverifyai"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
